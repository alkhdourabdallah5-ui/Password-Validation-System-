import java.util.Scanner;

public class PasswordValidationSystem {

    public static void calculate(String password) {

        char[] chars = password.toCharArray();

        int upper = 0;
        int lower = 0;
        int digit = 0;

        for (int i = 0; i < chars.length; i++) {

            if (chars[i] >= 'A' && chars[i] <= 'Z')
                upper++;

            else if (chars[i] >= 'a' && chars[i] <= 'z')
                lower++;

            else if (chars[i] >= '0' && chars[i] <= '9')
                digit++;
        }

        displayResult(password, upper, lower, digit);
    }

    public static void displayResult(String password, int upper, int lower, int digit) {

        System.out.println("Password: " + password);

        if (password.length() >= 8 && upper > 0 && lower > 0 && digit > 0)
            System.out.println("Password is Valid");
        else
            System.out.println("Password is Invalid");
    }

    public static void main(String[] args) {

        Scanner input = new Scanner(System.in);

        System.out.print("Enter Password: ");
        String password = input.nextLine();

        calculate(password);
    }
}
